# Copy this file to .env and adjust the values.
# docker compose reads it automatically; the backend reads the same variables
# when you run it outside Docker.

# --- PostgreSQL ---
POSTGRES_DB=culitostracker
POSTGRES_USER=culitos
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Backend ---
SERVER_PORT=8080
# JDBC URL the backend uses. Outside Docker point it at localhost;
# inside Docker Compose the hostname is "db".
DB_URL=jdbc:postgresql://localhost:5432/culitostracker
DB_USER=culitos
DB_PASSWORD=change-me-locally

# Secret used to sign JWT access tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=please-generate-a-real-secret-of-at-least-48-bytes
# Access token lifetime in minutes, refresh token lifetime in days.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring profiles. Add "demo" to load the demo seed (never in production).
SPRING_PROFILES_ACTIVE=

# --- Frontend ---
FRONTEND_PORT=5173
# Base URL the frontend uses to reach the API.
VITE_API_URL=http://localhost:8080
